# ========================================
# Configuration du serveur Invoke
# ========================================

# URL du serveur (utilisée pour générer les URLs des images uploadées)
# En développement : http://localhost:3000
# En production : https://votre-domaine.com
SERVER_URL=http://localhost:3000

# Configuration de la base de données MongoDB
MONGODB_URI=mongodb://localhost:27017/invoke
# Alternative avec authentification :
# MONGODB_URI=mongodb://username:password@localhost:27017/invoke

# Configuration JWT (JSON Web Tokens)
JWT_SECRET=votre-secret-jwt-super-securise-ici
JWT_EXPIRES_IN=7d
# Options : 1h, 24h, 7d, 30d

# Configuration des cookies
COOKIE_SECRET=votre-secret-cookie-super-securise-ici
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
# Mettre true en production avec HTTPS

# Configuration des logs
LOG_LEVEL=info
# Options : error, warn, info, debug

# Configuration du port
PORT=3000

# Configuration CORS
CORS_ORIGIN=http://localhost:5173
# En production : https://votre-domaine.com

# Configuration des uploads
MAX_FILE_SIZE=5242880
# 5MB en bytes (5 * 1024 * 1024)

# Configuration des rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# 15 minutes, 100 requêtes max

# Configuration des emails (optionnel)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=votre-email@gmail.com
# SMTP_PASS=votre-mot-de-passe-app

# Configuration des services externes (optionnel)
# GOOGLE_CLIENT_ID=votre-google-client-id
# GOOGLE_CLIENT_SECRET=votre-google-client-secret

# ========================================
# Instructions d'utilisation :
# ========================================
# 1. Copier ce fichier vers .env à la racine du serveur
# 2. Modifier les valeurs selon votre environnement
# 3. Ne jamais commiter le fichier .env dans Git
# 4. Utiliser des secrets forts en production
