# Configuration du serveur
PORT=3000
NODE_ENV=production

# Base de données
MONGODB_URI=mongodb+srv://your-mongodb-uri

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS - URLs autorisées pour le frontend
# Séparer plusieurs URLs par des virgules
FRONTEND_URLS=https://dev-invoke.onrender.com,https://invoke.vercel.app,http://localhost:5173,http://localhost:3000

# Rate limiting
DISABLE_RATE_LIMIT=false
