# Configuration serveur - Exemple
# Copiez ce fichier en .env et adaptez selon votre environnement

# ===== ENVIRONNEMENT =====
NODE_ENV=development  # development, staging, production
PORT=3000

# ===== BASE DE DONNÉES =====
MONGODB_URI=mongodb://localhost:27017/invoke

# ===== JWT =====
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ===== CORS ET DOMAINES =====
# En développement : http://localhost:5173
# En staging : https://dev-invoke.onrender.com
# En production : https://invoke.com
FRONTEND_URLS=http://localhost:5173,https://dev-invoke.onrender.com

# ===== COOKIES =====
# Domaine pour les cookies (vide pour auto-détection)
COOKIE_DOMAIN=
# En staging : .onrender.com
# En production : .invoke.com

# ===== RATE LIMITING =====
DISABLE_RATE_LIMIT=false

# ===== LOGS =====
LOG_LEVEL=info

# ===== CLOUDINARY =====
# Obtenez ces valeurs depuis https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
