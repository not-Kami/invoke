# Configuration du client Invoke

# URL de l'API backend
# En développement local : http://localhost:3000
# En production : https://votre-api-domain.com
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Configuration MetaMask (optionnel)
VITE_METAMASK_NETWORK_ID=1

# Configuration des logs
VITE_LOG_LEVEL=info
